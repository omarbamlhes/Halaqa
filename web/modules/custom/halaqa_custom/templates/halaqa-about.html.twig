        </div>
        <h3 class="about-mission-title">{{ 'Our Mission'|t }}</h3>
        <p class="about-mission-text">
          {{ 'To provide a comprehensive digital environment that supports Quran memorization, facilitates progress tracking, and enhances communication between teachers and students to achieve the highest levels of memorization proficiency.'|t }}
        </p>
      </div>

      <div class="about-mission-card about-mission-card--featured">
        <div class="about-mission-card-top">
          <div class="about-mission-icon about-mission-icon--vision">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
