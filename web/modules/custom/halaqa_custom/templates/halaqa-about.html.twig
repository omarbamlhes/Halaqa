          <span class="about-mission-number">02</span>
        </div>
        <h3 class="about-mission-title">{{ 'Our Vision'|t }}</h3>
        <p class="about-mission-text">
          {{ 'To be the leading platform in Quran memorization management worldwide, contributing to building a generation that preserves the Book of Allah with proficiency and dedication.'|t }}
        </p>
      </div>

      <div class="about-mission-card">
        <div class="about-mission-card-top">
          <div class="about-mission-icon about-mission-icon--values">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
