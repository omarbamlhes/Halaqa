{#
/**
 * @file
 * Halaqa Theme - Professional Page Template
 */
#}

<div class="layout-container">
  
  {# ==================== HEADER ==================== #}
  <header class="header" role="banner">
    <div class="header-inner">
      
      {# Logo & Branding #}
      <div class="site-branding">
        <a href="{{ path('<front>') }}" class="site-logo" rel="home" aria-label="{{ 'Home'|t }}">
          <img src="/themes/custom/halaqa_theme/images/favicon.svg" alt="Halaqa Logo" width="45" height="45" class="site-logo-img">
        </a>
        <div class="site-name-wrapper">
          <h1 class="site-name">
            <a href="{{ path('<front>') }}" rel="home">{{ site_name|default('حلقة') }}</a>
          </h1>
          <span class="site-slogan">{{ 'Quran Memorization Platform'|t }}</span>
        </div>
      </div>
      
      {# Main Navigation - Only one menu #}
      <nav class="main-navigation" role="navigation" aria-label="{{ 'Main navigation'|t }}">
        <ul class="menu">
          <li class="menu-item">
            <a href="{{ path('<front>') }}">{{ 'Home'|t }}</a>
          </li>
          {% if logged_in %}
            <li class="menu-item">
              <a href="/teacher/dashboard">{{ 'Dashboard'|t }}</a>
            </li>
            <li class="menu-item">
              <a href="/my-halaqas">{{ 'My Halaqas'|t }}</a>
            </li>
          {% endif %}
        </ul>
      </nav>
      
      {# Right Side: Search + User #}
      <div class="header-right">
        {# Single Search Box #}
        <div class="header-search">
          <input type="search" placeholder="{{ 'Search...'|t }}" aria-label="{{ 'Search'|t }}">
          <button type="submit" aria-label="{{ 'Search'|t }}">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.3-4.3"></path>
            </svg>
          </button>
        </div>

        {# Language Switcher #}
        <div class="language-switcher">
          {% if language.id == 'ar' %}
            <a href="/en" class="lang-toggle" aria-label="Switch to English">
              <span class="lang-icon">🌐</span>
              <span class="lang-text">EN</span>
            </a>
          {% else %}
            <a href="/ar" class="lang-toggle" aria-label="التبديل للعربية">
              <span class="lang-icon">🌐</span>
              <span class="lang-text">ع</span>
            </a>
          {% endif %}
        </div>

        {# User Menu #}
        {% if logged_in %}
          <div class="secondary-navigation">
            {# Notifications #}
            <div class="notification-bell-wrapper">
              <div class="notification-bell" aria-label="{{ 'Notifications'|t }}" data-notification-toggle>
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/>
                  <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>
                </svg>
                <span class="notification-badge hidden" data-notification-count>0</span>
              </div>

              {# Notification Dropdown #}
              <div class="notification-dropdown" data-notification-dropdown>
                <div class="notification-dropdown-header">
                  <span class="notification-dropdown-title">{{ 'Notifications'|t }}</span>
                  <a href="/notifications/mark-all-read" class="notification-dropdown-link" data-mark-all-read>{{ 'Mark all read'|t }}</a>
                </div>
                <div class="notification-dropdown-content" data-notification-list>
                  <div class="notification-dropdown-empty">
                    {{ 'Loading...'|t }}
                  </div>
                </div>
                <div class="notification-dropdown-footer">
                  <a href="/notifications">{{ 'View all notifications'|t }}</a>
                </div>
              </div>
            </div>
            
            {# User Avatar & Dropdown #}
            <div class="user-dropdown">
              <div class="user-avatar" aria-label="{{ 'User menu'|t }}">
                <span>👤</span>
              </div>
              <div class="user-dropdown-menu">
                <a href="/profile">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                  {{ 'My Profile'|t }}
                </a>
                <a href="/teacher/dashboard">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
                  {{ 'Dashboard'|t }}
                </a>
                <a href="/user/logout" class="logout">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
                  {{ 'Logout'|t }}
                </a>
              </div>
            </div>
          </div>
        {% else %}
          <div class="auth-buttons">
            <a href="/user/login" class="btn-login">{{ 'Login'|t }}</a>
            <a href="/user/register" class="btn-register">{{ 'Register'|t }}</a>
          </div>
        {% endif %}
        
        {# Mobile Menu Toggle #}
        <button class="mobile-menu-toggle" aria-label="{{ 'Toggle menu'|t }}">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
      
    </div>
  </header>

  {# ==================== MAIN CONTENT ==================== #}
  <main role="main" class="main-wrapper">
    <a id="main-content" tabindex="-1"></a>
    
    {# Messages #}
    {% if page.highlighted %}
      <div class="highlighted-region">
        {{ page.highlighted }}
      </div>
    {% endif %}

    {# Help Region #}
    {% if page.help %}
      <div class="help-region">
        {{ page.help }}
      </div>
    {% endif %}
    
    <div class="content-layout {% if page.sidebar_first or page.sidebar_second %}has-sidebar{% endif %}">
      
      {# Sidebar First #}
      {% if page.sidebar_first %}
        <aside class="sidebar sidebar-first" role="complementary">
          {{ page.sidebar_first }}
        </aside>
      {% endif %}
      
      {# Main Content #}
      <div class="main-content">
        {{ page.content }}
      </div>
      
      {# Sidebar Second #}
      {% if page.sidebar_second %}
        <aside class="sidebar sidebar-second" role="complementary">
          {{ page.sidebar_second }}
        </aside>
      {% endif %}
      
    </div>
  </main>

  {# ==================== FOOTER ==================== #}
  <footer class="footer" role="contentinfo">
    <div class="footer-inner">
      
      {# Footer Top - Links #}
      <div class="footer-top">
        <div class="footer-brand">
          <div class="footer-logo">
            <img src="/themes/custom/halaqa_theme/images/favicon.svg" alt="Halaqa Logo" width="40" height="40">
            <span>{{ site_name|default('حلقة') }}</span>
          </div>
          <p class="footer-description">
            {{ 'A smart platform for Quran memorization management connecting teachers, students, and parents.'|t }}
          </p>
        </div>
        
        <div class="footer-links">
          <div class="footer-column">
            <h4>{{ 'Quick Links'|t }}</h4>
            <ul>
              <li><a href="/teacher/dashboard">{{ 'Teacher Dashboard'|t }}</a></li>
              <li><a href="/student/dashboard">{{ 'Student Dashboard'|t }}</a></li>
              <li><a href="/parent/dashboard">{{ 'Parent Dashboard'|t }}</a></li>
            </ul>
          </div>
          <div class="footer-column">
            <h4>{{ 'Support'|t }}</h4>
            <ul>
              <li><a href="/help">{{ 'Help Center'|t }}</a></li>
              <li><a href="/contact">{{ 'Contact Us'|t }}</a></li>
              <li><a href="/privacy">{{ 'Privacy Policy'|t }}</a></li>
            </ul>
          </div>
        </div>
      </div>
      
      {# Footer Bottom #}
      <div class="footer-bottom">
        <div class="footer-verse quran-text">
          ﴿ وَلَقَدْ يَسَّرْنَا الْقُرْآنَ لِلذِّكْرِ فَهَلْ مِن مُّدَّكِرٍ ﴾
        </div>
        <div class="footer-copyright">
          <p>&copy; {{ 'now'|date('Y') }} {{ site_name|default('حلقة') }}. {{ 'All rights reserved.'|t }}</p>
        </div>
        <div class="footer-social">
          <a href="#" aria-label="Twitter" class="social-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="#" aria-label="Facebook" class="social-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="#" aria-label="YouTube" class="social-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
        </div>
      </div>
      
    </div>
  </footer>

</div>
