{#
/**
 * @file
 * Custom template for the user login page.
 * Professional and beautiful login page design.
 */
#}

<div class="login-page-wrapper">
  {# Animated Background #}
  <div class="login-background">
    <div class="bg-shape shape-1"></div>
    <div class="bg-shape shape-2"></div>
    <div class="bg-shape shape-3"></div>
    <div class="floating-icons">
      <span class="float-icon icon-1">📖</span>
      <span class="float-icon icon-2">🕌</span>
      <span class="float-icon icon-3">⭐</span>
      <span class="float-icon icon-4">🌙</span>
      <span class="float-icon icon-5">📿</span>
      <span class="float-icon icon-6">✨</span>
    </div>
  </div>

  {# Main Login Container #}
  <div class="login-container">
    {# Left Side - Branding & Info #}
    <div class="login-branding">
      <div class="branding-content">
        <div class="logo-section">
          <div class="logo-icon">
            <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <linearGradient id="loginLogoGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" style="stop-color:#ffd700"/>
                  <stop offset="100%" style="stop-color:#ffaa00"/>
                </linearGradient>
              </defs>
              <circle cx="50" cy="50" r="45" fill="url(#loginLogoGradient)" opacity="0.2"/>
              <path d="M25 70 L25 35 Q25 25 35 25 L65 25 Q75 25 75 35 L75 70" 
                    stroke="url(#loginLogoGradient)" stroke-width="3" fill="none"/>
              <path d="M30 70 L30 40 Q30 32 38 32 L62 32 Q70 32 70 40 L70 70" 
                    stroke="url(#loginLogoGradient)" stroke-width="2" fill="none"/>
              <line x1="35" y1="42" x2="65" y2="42" stroke="url(#loginLogoGradient)" stroke-width="1.5"/>
              <line x1="35" y1="50" x2="65" y2="50" stroke="url(#loginLogoGradient)" stroke-width="1.5"/>
              <line x1="35" y1="58" x2="55" y2="58" stroke="url(#loginLogoGradient)" stroke-width="1.5"/>
              <polygon points="50,12 53,18 59,19 54,24 56,30 50,27 44,30 46,24 41,19 47,18" 
                       fill="url(#loginLogoGradient)"/>
            </svg>
          </div>
          <h1 class="brand-title">{{ 'Halaqa'|t }}</h1>
          <p class="brand-subtitle">{{ 'Smart Platform for Quran Memorization'|t }}</p>
        </div>

        <div class="features-list">
          <div class="feature-item">
            <span class="feature-icon">📊</span>
            <div class="feature-text">
              <h4>{{ 'Track Progress'|t }}</h4>
              <p>{{ 'Monitor memorization journey with detailed analytics'|t }}</p>
            </div>
          </div>
          <div class="feature-item">
            <span class="feature-icon">👨‍🏫</span>
            <div class="feature-text">
              <h4>{{ 'Expert Teachers'|t }}</h4>
              <p>{{ 'Connect with qualified Quran teachers'|t }}</p>
            </div>
          </div>
          <div class="feature-item">
            <span class="feature-icon">👨‍👩‍👧‍👦</span>
            <div class="feature-text">
              <h4>{{ 'Family Dashboard'|t }}</h4>
              <p>{{ "Parents can follow their children's progress"|t }}</p>
            </div>
          </div>
        </div>

        <div class="quranic-verse">
          <p class="verse-arabic">وَرَتِّلِ الْقُرْآنَ تَرْتِيلًا</p>
          <p class="verse-translation">{{ '"And recite the Quran with measured recitation"'|t }}</p>
          <p class="verse-reference">{{ 'Al-Muzzammil: 4'|t }}</p>
        </div>
      </div>
    </div>

    {# Right Side - Login Form #}
    <div class="login-form-section">
      <div class="form-container">
        <div class="form-header">
          <h2 class="form-title">{{ 'Welcome Back'|t }} 👋</h2>
          <p class="form-subtitle">{{ 'Sign in to continue your journey'|t }}</p>
        </div>

        {# Messages #}
        {% if page.highlighted %}
          <div class="login-messages">
            {{ page.highlighted }}
          </div>
        {% endif %}

        {# Login Form Content #}
        <div class="login-form-wrapper">
          {{ page.content }}
        </div>

        {# Additional Links #}
        <div class="form-footer">
          <div class="divider">
            <span>{{ 'or'|t }}</span>
          </div>
          
          <div class="alternative-actions">
            <a href="/user/register" class="btn-register">
              <span class="btn-icon">✨</span>
              {{ 'Create New Account'|t }}
            </a>
            <a href="/user/password" class="btn-forgot">
              {{ 'Forgot Password?'|t }}
            </a>
          </div>
        </div>

        {# Quick Access Roles (Demo) #}
        <div class="role-hints">
          <p class="hints-title">{{ 'Quick Access'|t }}:</p>
          <div class="role-badges">
            <span class="role-badge teacher">👨‍🏫 {{ 'Teacher'|t }}</span>
            <span class="role-badge student">👨‍🎓 {{ 'Student'|t }}</span>
            <span class="role-badge parent">👨‍👩‍👧 {{ 'Parent'|t }}</span>
          </div>
        </div>
      </div>

      {# Language Switcher #}
      <div class="login-language-switch">
        {% if language.id == 'ar' %}
          <a href="/en/user/login" class="lang-link">
            <span class="lang-icon">🌐</span>
            English
          </a>
        {% else %}
          <a href="/ar/user/login" class="lang-link">
            <span class="lang-icon">🌐</span>
            العربية
          </a>
        {% endif %}
      </div>
    </div>
  </div>

  {# Footer #}
  <div class="login-footer">
    <p>© {{ 'now'|date('Y') }} {{ 'Halaqa Platform'|t }}. {{ 'All rights reserved.'|t }}</p>
  </div>
</div>

