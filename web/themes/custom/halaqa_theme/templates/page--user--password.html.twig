{#
/**
 * @file
 * Custom template for the user password reset page.
 * Professional and beautiful password reset page design.
 */
#}

<div class="login-page-wrapper password-page-wrapper">
  {# Animated Background #}
  <div class="login-background">
    <div class="bg-shape shape-1" style="background: linear-gradient(135deg, #667eea, #764ba2);"></div>
    <div class="bg-shape shape-2" style="background: linear-gradient(135deg, #f093fb, #f5576c);"></div>
    <div class="bg-shape shape-3" style="background: linear-gradient(135deg, #4facfe, #00f2fe);"></div>
    <div class="floating-icons">
      <span class="float-icon icon-1">🔐</span>
      <span class="float-icon icon-2">🔑</span>
      <span class="float-icon icon-3">📧</span>
      <span class="float-icon icon-4">🛡️</span>
      <span class="float-icon icon-5">✉️</span>
      <span class="float-icon icon-6">🔓</span>
    </div>
  </div>

  {# Main Container #}
  <div class="login-container" style="justify-content: center;">
    {# Center - Password Reset Form #}
    <div class="login-form-section" style="flex: none;">
      <div class="form-container" style="max-width: 450px;">
        <div class="form-header">
          <div class="password-icon" style="font-size: 4rem; margin-bottom: 20px;">🔐</div>
          <h2 class="form-title">{{ 'Reset Password'|t }}</h2>
          <p class="form-subtitle">{{ "Enter your email and we'll send you a reset link"|t }}</p>
        </div>

        {# Messages #}
        {% if page.highlighted %}
          <div class="login-messages">
            {{ page.highlighted }}
          </div>
        {% endif %}

        {# Password Reset Form Content #}
        <div class="login-form-wrapper password-form-wrapper">
          {{ page.content }}
        </div>

        {# Additional Links #}
        <div class="form-footer">
          <div class="divider">
            <span>{{ 'or'|t }}</span>
          </div>
          
          <div class="alternative-actions">
            <a href="/user/login" class="btn-register" style="background: linear-gradient(135deg, #667eea, #764ba2); color: white; border: none;">
              <span class="btn-icon">👈</span>
              {{ 'Back to Sign In'|t }}
            </a>
            <a href="/user/register" class="btn-forgot">
              {{ "Don't have an account? Sign Up"|t }}
            </a>
          </div>
        </div>

        {# Security Note #}
        <div class="security-note" style="margin-top: 25px; padding: 15px; background: rgba(102, 126, 234, 0.1); border-radius: 12px; text-align: center;">
          <p style="margin: 0; color: #6b7280; font-size: 0.9rem;">
            <span style="margin-right: 5px;">🔒</span>
            {{ 'We will send a secure link to your email'|t }}
          </p>
        </div>
      </div>

      {# Language Switcher #}
      <div class="login-language-switch">
        {% if language.id == 'ar' %}
          <a href="/en/user/password" class="lang-link">
            <span class="lang-icon">🌐</span>
            English
          </a>
        {% else %}
          <a href="/ar/user/password" class="lang-link">
            <span class="lang-icon">🌐</span>
            العربية
          </a>
        {% endif %}
      </div>
    </div>
  </div>

  {# Footer #}
  <div class="login-footer">
    <p>© {{ 'now'|date('Y') }} {{ 'Halaqa Platform'|t }}. {{ 'All rights reserved.'|t }}</p>
  </div>
</div>

